# /etc/nginx/sites-available/visura.malerba.info
# Symlink: ln -s /etc/nginx/sites-available/visura.malerba.info /etc/nginx/sites-enabled/

# Rate limiting
limit_req_zone $binary_remote_addr zone=visura_api:10m  rate=10r/s;
limit_req_zone $binary_remote_addr zone=visura_chat:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=visura_pdf:10m  rate=1r/s;

server {
    listen 80;
    listen [::]:80;
    server_name visura.malerba.info;

    # Certbot gestirà il redirect HTTP→HTTPS dopo: certbot --nginx -d visura.malerba.info
    # Nel frattempo lascia il server HTTP attivo per il challenge ACME.

    client_max_body_size 10M;

    # Endpoint chat (Claude extraction) — rate limit stretto
    location = /chat {
        limit_req zone=visura_chat burst=5 nodelay;
        proxy_pass         http://127.0.0.1:8001;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # PDF download — timeout lungo, buffer generoso
    location ~ ^/visura/.+/pdf$ {
        limit_req zone=visura_pdf burst=3 nodelay;
        proxy_pass         http://127.0.0.1:8001;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        proxy_buffer_size   16k;
        proxy_buffers       8 16k;
    }

    # Tutto il resto → FastAPI
    location / {
        limit_req zone=visura_api burst=20 nodelay;
        proxy_pass         http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
